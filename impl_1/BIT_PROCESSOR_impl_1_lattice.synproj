-a "MachXO3L"
-d LCMXO3L-6900C
-t CABGA256
-s 5
-frequency 200
-optimization_goal Balanced
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-force_gsr Auto
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-mux_style Auto
-max_fanout 1000
-fsm_encoding_style Auto
-twr_paths 3
-fix_gated_clocks 1
-loop_limit 1950




-use_io_insertion 1
-resolve_mixed_drivers 0
-use_io_reg auto


-lpf 1
-p "D:/ADELSOFT/LATTICE/projects/bit_processor"
-ver "D:/ADELSOFT/LATTICE/projects/bit_processor/top.v"
"D:/ADELSOFT/LATTICE/projects/bit_processor/clk.v"
"D:/ADELSOFT/LATTICE/projects/bit_processor/pc.v"
"D:/ADELSOFT/LATTICE/projects/bit_processor/mem.v"
"D:/ADELSOFT/LATTICE/projects/bit_processor/decoder.v"
-top top


-p "D:/ADELSOFT/LATTICE/ispfpga/xo3c00a/data" "D:/ADELSOFT/LATTICE/projects/bit_processor/impl_1" "D:/ADELSOFT/LATTICE/projects/bit_processor"

-ngd "BIT_PROCESSOR_impl_1.ngd"

